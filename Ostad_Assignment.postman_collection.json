              "pm.test(\"Status code is 200\", function(){\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst users = pm.response.json();\r\n\r\npm.test(\"Response contains user data\", function(){\r\n    pm.expect(users.length).to.be.greaterThan(0);\r\n    //console.log(users.length);\r\n});\r\n\r\npm.test(\"Each user has an id, name, and email\", function(){\r\n    \r\n    for (let i = 0; i<users.length; i++){\r\n        pm.expect(users[i]).to.have.property('id');\r\n        pm.expect(users[i]).to.have.property('name');\r\n        pm.expect(users[i]).to.have.property('email');\r\n        //console.log('My id, name, and email is ',users[i].id, users[i].name, users[i].email);\r\n    };\r\n});\r\n"
